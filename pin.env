# The Hermes iOS build this Swift Package ships.
# facebook/hermes no longer cuts independent Darwin releases.
# React Native publishes this tarball from a Hermes source build.
# Compiler and VM come from the same destroot.
HERMESVM_TAG=0.0.1
HERMES_IOS_VERSION=260318099.0.1
HERMES_IOS_TARBALL_URL=https://repo1.maven.org/maven2/com/facebook/hermes/hermes-ios/260318099.0.1/hermes-ios-260318099.0.1-hermes-ios-release.tar.gz
HERMES_GIT_URL=https://github.com/facebook/hermes
HERMES_GIT_REF=static_h
